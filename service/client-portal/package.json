    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prisma": "7.10.1",
    "supertest": "^7.3.2"
  }
}
