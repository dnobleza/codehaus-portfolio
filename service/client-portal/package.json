  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon",
    "start": "node --env-file=.env src/server.js",
    "test": "node --env-file-if-exists=.env.test --test --test-concurrency=1",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:create": "prisma migrate dev --create-only",
    "db:deploy": "prisma migrate deploy",
    "db:test:migrate": "node --env-file=.env.test node_modules/prisma/build/index.js migrate deploy"
  },
  "keywords": [],
  "author": "",
