# Required
PORT=3001
NODE_ENV=development
# FAKE values. Local docker compose uses port 5434. Tests use a separate database
# whose name must end with _test (NODE_ENV=test refuses to start otherwise).
DATABASE_URL=postgresql://user:password@localhost:5434/codehaus_portfolio
# FAKE value. Use a long random string (at least 32 characters) in your real .env.
JWT_SECRET=fake-secret-replace-me-with-32-or-more-random-characters

# Optional (defaults shown)
# Token lifetime: seconds (3600) or a number with a unit s, m, h or d (15m, 1d)
JWT_EXPIRES=1d
LOG_LEVEL=info
TRUST_PROXY=false
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
